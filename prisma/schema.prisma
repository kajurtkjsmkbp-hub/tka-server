generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/lms.db"
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  fullName  String
  role      String   // 'guru' or 'siswa'
  kelas     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  
  scores    Score[]
}

model Score {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  username  String
  materiId  String
  score     Int
  timestamp DateTime @default(now())

  @@unique([username, materiId])
}

model Announcement {
  id        Int      @id @default(1)
  message   String
  active    Boolean  @default(false)
  timestamp DateTime @default(now())
}
